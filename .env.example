# Frontend
VITE_API_URL=http://localhost:8080

# Backend / PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/dayflow
DATABASE_USERNAME=dayflow
DATABASE_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
APP_ORIGIN=http://localhost:5173
COMPANY_EMAIL_DOMAIN=example.com
COOKIE_SECURE=false

# SMTP (required for OTP, recovery, activation, and security notices)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=security@example.com

# WebAuthn. Production requires HTTPS and the real registrable domain.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# Used once only when no Admin/HR account exists. Remove after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
